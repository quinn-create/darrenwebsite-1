# Cloudflare Workers static assets (hosting decision C8). These files are served straight from
# Cloudflare's asset store, so the headers in next.config.ts never reach them; this file does.
# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching

# Code and styles: every file name carries a fingerprint, so browsers may keep them for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Link-preview images: file names carry a fingerprint too (scripts/make-share-cards.mjs).
/images/share/*
  Cache-Control: public, max-age=31536000, immutable

# Same basic protection as the pages (next.config.ts securityHeaders).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
