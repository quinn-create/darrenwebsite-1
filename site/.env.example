# Settings for the Darren Drake website. Copy the names into Cloudflare
# (Workers & Pages → ddrakelaw → Settings → Variables and Secrets; keys as type "Secret"),
# and SITE_ENV / NEXT_PUBLIC_* also into Settings → Build → Variables (they're read at build time).
# See plans/for-darren/cloudflare-setup.md. Never commit real values.

# --- Site ---
SITE_URL=https://ddrakelaw.com
# production = indexable and placeholder-checked; anything else = hidden from search engines
SITE_ENV=preview

# --- Where inquiries go ---
# "email" sends each inquiry by Postmark to INTAKE_EMAIL_TO, with a PDF attached.
INTAKE_DESTINATION=email
# Resend (the firm's choice, 26 Sep 2026): an API key with "Sending access" only.
RESEND_API_KEY=
# Postmark still works instead, if RESEND_API_KEY is left empty.
POSTMARK_SERVER_TOKEN=
# Must be an address on the domain verified in Resend, e.g. "Darren Drake Website <website@ddrakelaw.com>"
INTAKE_EMAIL_FROM=
# Comma-separated. Recipients decided 24 Sep 2026: see plans/for-darren/answers-2026-09-24.md (D8).
INTAKE_EMAIL_TO=first@example.com,second@example.com

# --- Optional: spam check on the form (Cloudflare Turnstile, free) ---
# Cloudflare dashboard → Turnstile → Add widget (hostname ddrakelaw.com, mode "Managed").
# The site key is public (build variable); the secret key goes in as type "Secret".
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: the same PDF by Telegram (the firm's choice, 24 Sep 2026) ---
# Bot token from @BotFather; chat id of Kelly's chat with the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: statistics and ad measurement (plans/cookie-consent-plan.md) ---
# Leave all blank for no cookie banner and no tracking. Each tag loads only after the
# visitor agrees in the banner. Values are read at build time: redeploy after changing.
# Google Analytics 4 measurement ID (G-…)
NEXT_PUBLIC_GA_ID=
# Google Ads account tag (AW-…) and the conversion labels for "form sent" and "phone tapped"
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=
# Meta (Facebook/Instagram) Pixel ID (digits)
NEXT_PUBLIC_META_PIXEL_ID=
