# Settings for the Darren Drake website. Copy the names into Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# --- Site ---
SITE_URL=https://ddrakelaw.com
# production = indexable and placeholder-checked; anything else = hidden from search engines
SITE_ENV=preview

# --- Where inquiries go ---
# "email" sends each inquiry by Postmark to INTAKE_EMAIL_TO, with a PDF attached.
INTAKE_DESTINATION=email
POSTMARK_SERVER_TOKEN=
# Must be an address on a domain verified in Postmark, e.g. website@ddrakelaw.com
INTAKE_EMAIL_FROM=
# Comma-separated. Recipients decided 24 Sep 2026: see plans/for-darren/answers-2026-09-24.md (D8).
INTAKE_EMAIL_TO=first@example.com,second@example.com

# --- Optional: the same PDF by Telegram (the firm's choice, 24 Sep 2026) ---
# Bot token from @BotFather; chat id of Kelly's chat with the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
